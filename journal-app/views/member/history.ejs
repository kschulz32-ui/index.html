<%- include('../partials/head', { pageTitle: 'Your journal' }) %>
<%- include('../partials/member_header', { member: member, active: 'history' }) %>

<h2 class="page-title">Your journal</h2>
<p class="subhead">Flip back through what you've written, week by week.</p>

<% if (saved) { %>
  <div class="notice">Saved. That's one small, brave step for this week.</div>
<% } %>

<% if (pages.length === 0) { %>
  <div class="empty-state">
    <p>The journal's just getting started.</p>
    <p>Once this week's message goes out, you'll have a page to write in.</p>
  </div>
<% } else if (!hasWrittenAnything) { %>
  <div class="empty-state">
    <p><strong>Your journal is empty for now — that's alright.</strong></p>
    <p>Open any week below when you're ready to write the first page.</p>
  </div>
<% } %>

<% pages.forEach(function(p) { %>
  <div class="entry-page">
    <div class="entry-head">
      <span class="entry-date"><%= p.entry.sermon_date %></span>
      <h2 class="entry-title"><%= p.entry.sermon_title %></h2>
    </div>

    <div class="prompt-box">
      <span class="label">That week's entry prompt</span>
      <%= p.entry.prompt_text %>
    </div>

    <% if (p.response && (p.response.personal_text || p.response.work_text || p.response.family_text)) { %>
      <% if (p.response.personal_text) { %><p><strong>Personal:</strong> <%= p.response.personal_text %></p><% } %>
      <% if (p.response.work_text) { %><p><strong>Work:</strong> <%= p.response.work_text %></p><% } %>
      <% if (p.response.family_text) { %><p><strong>Family:</strong> <%= p.response.family_text %></p><% } %>

      <details>
        <summary>Edit this entry</summary>
        <form method="post" action="/journal/<%= member.token %>/entries/<%= p.entry.id %>">
          <input type="hidden" name="return_to" value="history">
          <label for="personal_<%= p.entry.id %>">Personal</label>
          <textarea id="personal_<%= p.entry.id %>" name="personal_text"><%= p.response.personal_text || '' %></textarea>
          <label for="work_<%= p.entry.id %>">Work</label>
          <textarea id="work_<%= p.entry.id %>" name="work_text"><%= p.response.work_text || '' %></textarea>
          <label for="family_<%= p.entry.id %>">Family</label>
          <textarea id="family_<%= p.entry.id %>" name="family_text"><%= p.response.family_text || '' %></textarea>
          <div class="actions"><button type="submit">Save this entry</button></div>
        </form>
      </details>
    <% } else { %>
      <p class="helper-text">Pick this back up when you're ready.</p>
      <details>
        <summary>Write this entry</summary>
        <form method="post" action="/journal/<%= member.token %>/entries/<%= p.entry.id %>">
          <input type="hidden" name="return_to" value="history">
          <label for="personal_<%= p.entry.id %>">Personal</label>
          <textarea id="personal_<%= p.entry.id %>" name="personal_text"></textarea>
          <label for="work_<%= p.entry.id %>">Work</label>
          <textarea id="work_<%= p.entry.id %>" name="work_text"></textarea>
          <label for="family_<%= p.entry.id %>">Family</label>
          <textarea id="family_<%= p.entry.id %>" name="family_text"></textarea>
          <div class="actions"><button type="submit">Save this entry</button></div>
        </form>
      </details>
    <% } %>
  </div>
<% }) %>

<%- include('../partials/foot') %>
