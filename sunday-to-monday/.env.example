# Postgres connection string. Any Postgres 14+ works (local, Supabase, Replit, Neon...).
DATABASE_URL=postgres://stm:stm@localhost:5432/stm
# Used by `npm test` (the tests wipe this database, never point it at real data)
TEST_DATABASE_URL=postgres://stm:stm@localhost:5432/stm_test

# Public base URL, used in magic links and emails
APP_URL=http://localhost:3000

# Email: "console" prints emails to the server log (dev only). A real provider gets added later.
EMAIL_DRIVER=console
EMAIL_FROM="Sunday to Monday <hello@example.org>"

# Optional. Without it the app still works: leaders write takeaways by hand,
# and daily actions come from built-in templates.
ANTHROPIC_API_KEY=
